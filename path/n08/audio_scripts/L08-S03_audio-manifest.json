   "section": "listening",
   "speaker": "Markus",
   "accent": "German",
   "voice_id": null,
   "model_id": null,
   "text": "My name is Markus. I was twenty-four when I found out. One Tuesday I came home early and my father was in the kitchen at eleven in the morning. He said the office was closed that day.",
   "chars": 183,
   "status": "pendiente"
  },
